{
  "name": "prospect-crm-mcp",
  "version": "1.14.1",
  "description": "MCP server for Prospect365 CRM - Quote management for WCG",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test:api": "node dist/test-api.js",
    "test:messaging": "node --test dist/test-messaging.js",
    "test:divisions": "node --test dist/test-divisions.js",
    "test:division-writes": "node --test dist/test-division-writes.js",
    "test:dropdowns": "node --test dist/test-dropdowns.js",
    "test:companies": "node --test dist/test-companies.js",
    "test:sector": "node --test dist/test-sector.js",
    "test:versa": "node --test dist/test-versa.js",
    "test:send-message": "node dist/test-send-message.js",
    "test:credentials": "node --test dist/test-credentials.js",
    "test:role-mapper": "node --test dist/test-role-mapper.js",
    "test:status-details": "node --test dist/test-status-details.js",
    "test:quote-line-xtra": "node --test dist/test-quote-line-xtra.js",
    "test:search-products": "node --test dist/test-search-products.js",
    "enable-autoupdate": "node scripts/enable-autoupdate.cjs",
    "setup": "node scripts/setup.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
